## MODEL INITIALIZATION (BEST PRACTICES)

### Complete example de carga de modelo

```python
import torch
import torch.nn as nn
import logging

logger = logging.getLogger(__name__)

class Pipeline:
    def __init__(self, model_path: str):
        self.model_path = model_path
        self.device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
        self.model = None
        self._load_model()
    
    def _load_model(self):
        try:
            # 1. Verificar que el modelo existe
            if not os.path.exists(self.model_path):
                raise FileNotFoundError(f"Model not found: {self.model_path}")
            
            # 2. Crear arquitectura
            self.model = self._create_model_architecture()
            
            # 3. Cargar pesos (SEGURO con weights_only=True)
            checkpoint = torch.load(
                self.model_path,
                map_location=self.device,
                weights_only=True  # SECURITY
            )
            
            # 4. Load state dict
            self.model.load_state_dict(checkpoint['model_state_dict'])
            
            # 5. Mover a device
            self.model.to(self.device)
            
            # 6. Set eval mode
            self.model.eval()
            
            logger.info(f"✅ Model loaded from {self.model_path}")
            logger.info(f"✅ Device: {self.device}")
            
        except Exception as e:
            logger.error(f"❌ Failed to load model: {e}")
            raise
    
    def _create_model_architecture(self):
        # Definir arquitectura del modelo
        # (debe coincidir con el modelo guardado)
        model = MyModelArchitecture()
        return model
```

